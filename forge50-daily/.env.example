# Supabase (project forge50-daily, ref kjxnogisqqqdcrdgygco)
NEXT_PUBLIC_SUPABASE_URL=https://kjxnogisqqqdcrdgygco.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_dLF4k0ljwA90tPjJbwDIwA_D0ghd9rv

# The owner's timezone decides what "today" is. Keep in sync with the
# APP_TIMEZONE secret on the daily-recommendation edge function.
APP_TIMEZONE=America/Los_Angeles
# Day 1 of week 1 of the program (YYYY-MM-DD). Keep in sync with the
# PROGRAM_START_DATE secret on the daily-recommendation edge function.
PROGRAM_START_DATE=

# Google Calendar (read-only). Create the refresh token with
# `node scripts/google-refresh-token.mjs`.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Comma-separated calendar IDs; defaults to primary.
GOOGLE_CALENDAR_IDS=primary

# Todoist (read-only). Settings → Integrations → Developer → API token.
TODOIST_API_TOKEN=
# Any Todoist filter query; defaults to "today | overdue".
TODOIST_FILTER=today | overdue
TODOIST_LIMIT=8
